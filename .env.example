# From https://mediasfu.com/api-keys (server-side only). Start with a sandbox key.
MEDIASFU_API_USERNAME=
MEDIASFU_API_KEY=
# Optional: nickname of a translation config (dashboard > Translation) with your own STT/LLM/TTS keys.
# Leave empty to use MediaSFU-managed translation.
MEDIASFU_TRANSLATION_CONFIG=
# Organisers enter this to create events (8+ characters). Replace with your own login later.
ORGANIZER_CODE=
# Signs event links. 32+ random characters, e.g. `openssl rand -hex 32`.
EVENT_LINK_SECRET=
